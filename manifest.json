{
  "manifest_version": 3,
  "name": "an-history",
  "version": "0.1.1",
  "description": "按域名分组管理浏览器历史：组内按时间排序，支持单条/整组删除，清理地址栏历史补全。",
  "minimum_chrome_version": "116",
  "permissions": ["history", "favicon", "storage", "tabs"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 an-history（历史记录）",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "chrome_url_overrides": {
    "history": "history.html"
  },
  "commands": {
    "open-history": {
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "Command+Shift+H"
      },
      "description": "打开 an-history 历史记录页"
    }
  }
}
